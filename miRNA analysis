# first need to make names of mirs consistant as they may have a slighty different format between the seq data and the target scan database 
standardize_mirna <- function(mirna_names) {
  # This regex will match 'miR/let-' followed by numbers and optional letters
  standardized <- str_extract(mirna_names, "...-\\d+[a-z]?(-3p|-5p)?") 
  # Convert all to lowercase
  tolower(standardized)
}

