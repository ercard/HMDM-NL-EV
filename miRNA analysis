# read in fkpm counts of HMDM mRNA seq #
HMDM_fkpm <- read.csv("gene_fpkm.xls.csv")
# remove columns of NMV treated cells ##
head(HMDM_fkpm, 1)
M0_fkpm <- HMDM_fkpm  %>%
  select (-contains(c('2', '3', '4')))
head(M0_fkpm,1)
## MAKE A COLUMN CONTAINING AVERAGE COUNT PER GENE AND EXLUDE THOSE WITH AN EXPRESSION UNDER 10 ##
M0_fkpm['average_count'] = rowMeans(M0_fkpm[,2:9])
M0_fkpm <- M0_fkpm %>% 
  arrange(desc(average_count)) %>%
  filter(average_count > 0.3)  
#### REMOVE TARGETS FROM MIRTARBASE LIST IF NOT EXPRESSED IN MACROPHAGES ##
M0_gene_names <- M0_fkpm$gene_name
mirtarbase <- subset(mirtarbase, Target.Gene %in%  M0_gene_names)
