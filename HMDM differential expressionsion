results_UT_vs_PBS <- results(dds, contrast=c("Condition","PBS_NMV","UT"),tidy=TRUE)  %>%
  arrange(pvalue) %>%
  write_csv("ddsconditionUT_vs_PBS_new.csv")
##### volcano plot UT vs PBS ###
sig_results_UT_vs_PBS <- results_UT_vs_PBS %>%
  subset(pvalue<0.05) 
##### make signifcant up regulated sheet #####
sig_results_UT_vs_PBS_UP <- results_UT_vs_PBS %>%
  subset(pvalue<0.05) %>%
  subset(log2FoldChange>0) %>%
  write.csv("sig_diff_Pvalue_UT_vs_PBS_UP.csv")
##### make signifcant down regulated sheet #####
sig_results_UT_vs_PBS_down <- results_UT_vs_PBS %>%
  subset(pvalue<0.05) %>%
  subset(log2FoldChange<0) %>%
  write.csv("sig_diff_Pvalue_UT_vs_PBS_down.csv")
#### make column called diffexprressed ######
results_UT_vs_PBS$diffexpressed <- "NO"
results_UT_vs_PBS$diffexpressed[results_UT_vs_PBS$log2FoldChange > 0.0 & results_UT_vs_PBS$padj < 0.1] <- "UP"
results_UT_vs_PBS$diffexpressed[results_UT_vs_PBS$log2FoldChange < -0.0 & results_UT_vs_PBS$padj < 0.1] <- "DOWN"
head(results_UT_vs_PBS)
unique(results_UT_vs_PBS$diffexpressed)
table(results_UT_vs_PBS$diffexpressed)
###### make top column ######
results_UT_vs_PBS$Top <- ifelse(results_UT_vs_PBS$row %in% head(arrange(results_UT_vs_PBS,padj),20)
                                $row & results_UT_vs_PBS$diffexpressed != "NO", results_UT_vs_PBS$row, NA)
head(results_UT_vs_PBS)
View(results_UT_vs_PBS)
####### plot #######
table(results_UT_vs_PBS$diffexpressed)
UT_vs_PBS <- ggplot(results_UT_vs_PBS, aes(x = log2FoldChange, y = log10(padj), col = diffexpressed, label=Top))+
  geom_vline(xintercept = 0, col = "black", linetype = 'dashed', linewidth=0.8) +
  geom_hline(yintercept = log10(0.1), col = "black", linetype = 'dashed', linewidth=0.8) +
  xlim(-1,1.5)+
  ylim(0,-3)+
  scale_y_reverse() +
  geom_point(size = 3) +
  scale_color_manual(values = "grey40",
                     labels = "NO") +
  labs(x = expression("log"[2]*"FC"), y = expression("log"[10]*"p-adjusted value"))+
  ggtitle('PBS NMV vs CTRL') +geom_text_repel(max.overlaps = 10, size=2.5, fontface="bold")+
  theme(legend.title = element_blank(), plot.title.position = "right", plot.title = element_text(hjust = 0.5))+
  theme_bw() +
  theme(aspect.ratio = 1)
UT_vs_PBS

