  "cytosolic ribosome" = "#35ee35", "small ribosomal subunit" = "#B4EEB4", "ribosome" = "#9BCD9B","ribonucleoprotein complex" = "#5fc45f","ribosomal subunit" = "#698B69", #CC colour  
  "structural constituent of ribosome" = "#ff1d8e","structural molecule activity"="#e880b4")

### Ensure the dataframe is physically sorted by this order
plot_data_PBS$label <- factor(plot_data_PBS$label, levels = unique(plot_data_PBS$label))
plot_data_PBS <- plot_data_PBS %>%
  arrange(label, level)
# 3. Create the Plot
donut_plot_PBS <- ggplot(plot_data_PBS, aes(x = level, y = count, fill = label)) +
  # White borders 
  geom_col(color = "white", width = 1) +
  # Convert to polar
  coord_polar(theta = "y") +
  # xlim(0.5, 3.5) creates the hole. 3.5 provides room for the outer ring.
  xlim(0.5, 3.5) +
  # Annotation for the center hole
  annotate("text", x = 0.5, y = 0, label = "GO enriched
  PBS NL-EV", 
           fontface = "bold", size = 4) +
  # Add the counts inside segments
  scale_fill_manual(values = my_colors_PBS) + # Use the colour pallette 
  geom_text(aes(label = text_label), 
            position = position_stack(vjust = 0.5), 
            size = 3, fontface = "bold") +
  theme_void()
donut_plot_PBS

