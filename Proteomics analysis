### MF ####
GSE_GO_MF_oxLDL_Protein <-  GSE_GO_MF_oxLDL_Protein_ENTREZ_df[1:2,]
GSE_GO_MF_oxLDL_Protein <- data.frame(class = rep('MF', 2),
                                    category = GSE_GO_MF_oxLDL_Protein$Description,
                                    count = GSE_GO_MF_oxLDL_Protein$Count) 
View(GSE_GO_MF_oxLDL_Protein)
### join dat frames###
combined_oxLDL_GO <- rbind(GSE_GO_BP_oxLDL_Protein, GSE_GO_CC_oxLDL_Protein, GSE_GO_MF_oxLDL_Protein)
View(combined_oxLDL_GO)
combined_oxLDL_GO <- combined_oxLDL_GO %>% arrange(class, category)
#make plot 
# Inner Ring: Categories
inner_ring_oxLDL <- combined_oxLDL_GO %>%
  mutate(level = 2, label = category,
         text_label = as.character(count))

# Outer Ring: Group totals
outer_ring_oxLDL <- combined_oxLDL_GO %>%
  group_by(class) %>%
  summarise(count = sum(count)) %>%
  arrange(class) %>%
  mutate(level = 3, label = class,
         text_label = class)

# Combine for plotting
plot_data_oxLDL <-  bind_rows(inner_ring_oxLDL, outer_ring_oxLDL) %>%
  arrange(class, level)
View(plot_data_oxLDL)
# decide colours
my_colors_oxLDL <- c(
  "BP" = "#f7dafa", "CC" = "#ddfada", "MF" = "#fadaed",          # Neutral Outer
  "translation" = "#f600f6", "protein metabolic process" = "#cd00cd", "cytoplasmic translation" = "#b700b7", #colours for bp 
  "cytosolic ribosome" = "#35ee35", "ribosomal subunit" = "#B4EEB4", "ribosome" = "#9BCD9B","ribonucleoprotein complex" = "#5fc45f","large ribosomal subunit" = "#698B69", #CC colour 
  "structural constituent of ribosome" = "#ff1d8e","structural molecule activity"="#e880b4")

### Ensure the dataframe is physically sorted by this order
plot_data_oxLDL$label <- factor(plot_data_oxLDL$label, levels = unique(plot_data_oxLDL$label))
plot_data_oxLDL <- plot_data_oxLDL %>%
  arrange(label, level)
# 3. Create the Plot
donut_plot_oxLDL <- ggplot(plot_data_oxLDL, aes(x = level, y = count, fill = label)) +
  # White borders 
  geom_col(color = "white", width = 1) +
  # Convert to polar
  coord_polar(theta = "y") +
  # xlim(0.5, 3.5) creates the hole. 3.5 provides room for the outer ring.
  xlim(0.5, 3.5) +
  # Annotation for the center hole
  annotate("text", x = 0.5, y = 0, label = "GO enriched
  oxLDL NL-EV", 
           fontface = "bold", size = 4) +
  # Add the counts inside segments
  scale_fill_manual(values = my_colors_oxLDL) + # Use the colour pallette 
  geom_text(aes(label = text_label), 
            position = position_stack(vjust = 0.5), 
            size = 3, fontface = "bold") +
  theme_void()
donut_plot_oxLDL

