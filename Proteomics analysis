#### cc## 
GSE_GO_CC_oxLDL_Protein <- GSE_GO_CC_oxLDL_Protein_ENTREZ_df[1:5,]
GSE_GO_CC_oxLDL_Protein <- data.frame(class = rep('CC', 5),
                                    category = GSE_GO_CC_oxLDL_Protein$Description,
                                    count = GSE_GO_CC_oxLDL_Protein$Count) 
