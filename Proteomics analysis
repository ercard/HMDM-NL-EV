####### Make Venn diagram ####
#### make sheets of UNIPROTIDS ##
PBS <- PBS_Proteins$UNIPROT
nLDL <- nLDL_Proteins$UNIPROT
oxLDL <- oxLDL_Proteins$UNIPROT

### make venn plot ###
#find intercets 
intersect_PBS_nLDL <- intersect(PBS,nLDL)
intersect_nLDL_oxLDL <- intersect(nLDL,oxLDL)
intersect_PBS_oxLDL <- intersect(PBS,oxLDL)
intersect_all <- intersect(intersect_PBS_nLDL,oxLDL)
print(intersect_all)
venn.plot <- draw.triple.venn(length(PBS), length(nLDL), length(oxLDL),
                              length(intersect_PBS_nLDL),
                              length(intersect_nLDL_oxLDL),
                              length(intersect_PBS_oxLDL),
                              length(intersect(intersect_PBS_nLDL,oxLDL)),
                              category = c("PBS NL-EV", "nLDL NL-EV", "oxLDL NL-EV"),
                              rotation = 1, 
                              reverse = FALSE, 
                              euler.d =FALSE, 
                              scaled = FALSE,
                              fill = c("#CC66FF", "#009E73", "#56B4E9"),
                              alpha = rep(0.2,3),
                              lwd = rep(4, 3), 
                              lty = rep("blank", 3), 
                              col = rep("black", 3),
                              cex = rep(4, 7), 
                              fontface = rep("italic", 7), 
                              fontfamily = rep("serif", 7),
                              sigdigs = 3, 
                              direct.area = FALSE, 
                              area.vector = 0,
                              cat.cex = 3,
                              cat.fontface = "bold",
                              cat.default.pos = "outer")
                              
grid.draw(venn.plot)
#### oxLDL NMVs have the most unique proteins so want to make a dataframe containing these unique proteins and their intensities ####
# make a joint data frame with all the proteins from PBS and nLDL vesicles 
nLDL_Proteins$SYMBOL.x <- NULL
nLDL_Proteins <- nLDL_Proteins %>%
  rename(SYMBOL.y = "SYMBOL")
PBS_nLDL_proteins <- rbind(PBS_Proteins, nLDL_Proteins)
# find proteins that are unique to oxLDL #
oxLDL_unique_proteins <- anti_join(oxLDL_Proteins, PBS_nLDL_proteins, by= "SYMBOL")
View(oxLDL_unique_proteins)
write.csv(oxLDL_unique_proteins, "oxLDL_unique_proteins.csv")
